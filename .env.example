# Database (local dev — file-based SQLite)
DATABASE_URL="file:./dev.db"

# Turso (production on Vercel — https://turso.tech)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Vercel Blob (production file uploads — create in Vercel project Storage tab)
BLOB_READ_WRITE_TOKEN=""

# Auth
JWT_SECRET="change-me-in-production"
ADMIN_EMAILS="admin@hackstreetboys.com"

# Public URL for invite links (optional on Vercel — VERCEL_URL is used automatically)
APP_URL="http://localhost:3000"

# EmailJS — tester invitation emails
# See README "EmailJS Setup" for dashboard steps and template HTML.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# Optional: Internal-App Firestore sync
FIREBASE_PROJECT_ID=""
FIREBASE_API_KEY=""
